// gniri: niri config fragment.
//
// Add one line to ~/.config/niri/config.kdl to use it:
//     include "/absolute/path/to/gniri.kdl"
//
// gniri's docs/DECISIONS.md records the measurements behind each value
// here.

// blur-my-shell's default blur adds no noise and leaves saturation alone;
// niri's defaults (noise 0.02, saturation 1.5) would tint every blurred
// surface differently from GNOME. Its 0.6 brightness has no niri equivalent
// and is folded into gniri's tint colours instead (crates/theme/scss/_bms.scss).
//
// `passes` and `offset` set the strength. blur-my-shell's default is equal to
// a Gaussian of sigma 7.5 logical pixels; these values are the closest niri
// gets (tools/blur-fit/fit.py, fitted at output scale 1.25). niri's defaults
// (3 and 3) are visibly stronger.
//
// This section is global: it also changes blur for other apps.
blur {
    passes 3
    offset 1.3
    noise 0
    saturation 1
}

// Menus, dialogs, banners and the OSD blur what is really behind them, as
// blur-my-shell's popups do. Without this rule niri blurs only the wallpaper
// ("xray"), which is what the panel wants and is also much cheaper.
layer-rule {
    match namespace="^gniri-(stage|banner|osd|dialog)$"

    background-effect {
        xray false
    }
}

// The pre-blurred wallpaper copy sits behind the zoomed-out workspaces in the
// overview, like blur-my-shell's overview background.
layer-rule {
    match namespace="^gniri-backdrop$"

    place-within-backdrop true
}

// gniri puts a search entry at the top of niri's overview and a dash at
// the bottom, as GNOME has them, and takes the keyboard there so that
// typing searches. This zoom leaves the workspace in the middle clear of
// both on a screen 800 logical pixels high or more; GNOME's own is a
// little larger and niri allows up to 0.75.
overview {
    zoom 0.7
}

// The volume and brightness keys change the level through gniri, which
// shows GNOME's on-screen display. A later bind of a key replaces an
// earlier one, so put the include line after your own `binds` for these to
// win.
//
// The binds start gniri by the name it is installed under: `cargo xtask
// install` writes the full path in. In the repository's copy that is plain
// `gniri`, which niri finds only if it is on PATH.
//
// Super+Alt+L locks the screen (niri's own suggestion for a screen locker;
// Super+L, GNOME's, moves the focus in niri). Ctrl+Alt+Delete asks whether
// to power off, as in GNOME.
//
// Super+A opens the app grid, as in GNOME.
binds {
    Super+A { spawn "gniri" "msg" "apps"; }
    Super+Alt+L { spawn "gniri" "msg" "lock"; }
    Ctrl+Alt+Delete { spawn "gniri" "msg" "power-off"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "gniri" "msg" "volume" "up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "gniri" "msg" "volume" "down"; }
    XF86AudioMute allow-when-locked=true { spawn "gniri" "msg" "volume" "mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "gniri" "msg" "brightness" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "gniri" "msg" "brightness" "down"; }
}
