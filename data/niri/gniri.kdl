// gniri: niri config fragment.
//
// Add one line to ~/.config/niri/config.kdl to use it:
//     include "/absolute/path/to/gniri.kdl"
//
// docs/DECISIONS.md records the measurements behind each value here.

// blur-my-shell's default blur adds no noise and leaves saturation alone;
// niri's defaults (noise 0.02, saturation 1.5) would tint every blurred
// surface differently from GNOME. Its 0.6 brightness has no niri equivalent
// and is folded into gniri's tint colours instead (crates/theme/scss/_bms.scss).
//
// `passes` and `offset` set the strength. blur-my-shell's default is equal to
// a Gaussian of sigma 7.5 logical pixels; these values are the closest niri
// gets (tools/blur-fit/fit.py, fitted at output scale 1.25). niri's defaults
// (3 and 3) are visibly stronger.
//
// This section is global: it also changes blur for other apps.
blur {
    passes 3
    offset 1.3
    noise 0
    saturation 1
}

// Menus, dialogs, banners and the OSD blur what is really behind them, as
// blur-my-shell's popups do. Without this rule niri blurs only the wallpaper
// ("xray"), which is what the panel wants and is also much cheaper.
layer-rule {
    match namespace="^gniri-(stage|banner|osd)$"

    background-effect {
        xray false
    }
}

// The pre-blurred wallpaper copy sits behind the zoomed-out workspaces in the
// overview, like blur-my-shell's overview background.
layer-rule {
    match namespace="^gniri-backdrop$"

    place-within-backdrop true
}
